# NOTE:
# This repo environment blocks creating `.env.example` directly.
# Use this file as the template and copy it to `.env` (or rename it to `.env.example`) in your environment.

# SvelteKit app (adapter-node)
HOST=0.0.0.0
PORT=3000

# Public URL of the app (behind Nginx Proxy Manager)
# Useful for absolute URLs, redirects, emails, OAuth callbacks, etc.
PUBLIC_APP_URL=https://paaa.prolocoventicano.com

# SvelteKit/adapter-node: canonical origin (recommended behind a reverse proxy)
ORIGIN=https://paaa.prolocoventicano.com

# LibSQL/sqld (internal Docker DNS)
# Use the compose service name "db" on the shared external network.
DATABASE_URL=http://db:8080

# Optional: if you enable authentication at the app/db layer.
DATABASE_AUTH_TOKEN=

# Optional: protect sqld admin API (namespace management).
# If set, your tooling/app must send it when calling the admin endpoints.
LIBSQL_ADMIN_AUTH_KEY=

# Optional: internal admin API base URL (not for end-users)
DATABASE_ADMIN_URL=http://db:9090

# REQUIRED: secret used to sign session JWTs (min 32 characters).
# The app refuses to start without it. Generate with: openssl rand -base64 48
AUTH_SECRET=

# Super admin seeded at first startup (see entrypoint.sh)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Versioning ---
# Application version (see README.md → Versionamento). Keep in sync with package.json.
APP_VERSION=0.2.0

# Schema push safety: drizzle-kit push runs at container startup.
# Set to "true" ONLY to approve destructive schema changes, then set back to false.
DRIZZLE_FORCE_PUSH=false

# Max accepted request body. svelte-adapter-bun defaults to 512K when this is
# unset, which silently caps every upload well below the 5 MB (images) and
# 20 MB (message attachments) limits enforced in src/lib/server/uploads.ts.
# Lower it if you want a tighter ceiling on upload abuse — but keep it above
# the largest attachment you actually need, or uploads fail with a bare 413.
# Nginx Proxy Manager needs a matching client_max_body_size (nginx default 1M).
BODY_SIZE_LIMIT=21M



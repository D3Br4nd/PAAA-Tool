{
  "name": "paaa-tool",
  "version": "0.2.0",
  "description": "Piattaforma self-hosted per eventi di caccia al tesoro gamificati e gestione giochi a squadre",
  "license": "MIT",
  "author": "Max Brandini",
  "repository": {
    "type": "git",
    "url": "https://github.com/D3Br4nd/PAAA-Tool.git"
  },
  "type": "module",
  "scripts": {
    "sync": "svelte-kit sync",
    "dev": "svelte-kit sync && vite dev",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview",
    "test": "bun test",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:push": "bunx drizzle-kit push",
    "db:generate": "bunx drizzle-kit generate",
    "db:studio": "bunx drizzle-kit studio"
  },
  "dependencies": {
    "@dicebear/core": "^10.5.0",
    "@dicebear/styles": "^10.4.0",
    "@libsql/client": "^0.17.0",
    "@sqlite.org/sqlite-wasm": "^3.51.2-build5",
    "@sveltejs/kit": "^2.50.1",
    "@tanstack/svelte-query": "^6.0.18",
    "@types/qrcode": "^1.5.6",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "jose": "^6.1.3",
    "lucide-svelte": "^0.563.0",
    "qrcode": "^1.5.4",
    "tailwind-merge": "^3.4.0",
    "uuidv7": "^1.1.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/bun": "^1.3.6",
    "@types/node": "^25.0.10",
    "autoprefixer": "^10.4.23",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.4.1",
    "svelte": "^5.48.2",
    "svelte-adapter-bun": "^1.0.1",
    "svelte-check": "^4.3.5",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
